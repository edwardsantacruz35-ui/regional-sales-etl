function ejecutarReconstruccion() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();
  
  try {
    const hojasRequeridas = ["Input_VE", "Input_CO", "Input_GU", "Tasas"];
    let faltantes = hojasRequeridas.filter(h => !ss.getSheetByName(h));
    if (faltantes.length > 0) {
       ui.alert("⚠️ ALERTA: Faltan hojas: " + faltantes.join(", "));
       return; 
    }

    configurarEstructura(ss);
    const configClientes = obtenerConfigClientes(ss);
    const tasasPorPais = obtenerTasasPorPais(ss); 

    // LIMPIEZA
    limpiarHoja(ss, "Data VE");
    limpiarHoja(ss, "Data GU");
    limpiarHoja(ss, "Data CO");
    limpiarHoja(ss, "B2C RED VE");
    limpiarHoja(ss, "ERRORES"); 

    let erroresGlobal = [];

    // PROCESAMIENTO
    let repVE = reconstruirVenezuela(ss, configClientes, erroresGlobal);
    let repGU = reconstruirGuatemala(ss, configClientes, tasasPorPais.GU, erroresGlobal);
    let repCO = reconstruirColombia(ss, configClientes, tasasPorPais.CO, erroresGlobal);

    // REPORTE ERRORES
    if (erroresGlobal.length > 0) {
        pegarCompacto(ss.getSheetByName("ERRORES"), erroresGlobal);
        aplicarEstiloVisual(ss.getSheetByName("ERRORES"));
    }

    // ESTILO DATA
    aplicarEstiloVisual(ss.getSheetByName("Data VE"));
    aplicarEstiloVisual(ss.getSheetByName("Data GU"));
    aplicarEstiloVisual(ss.getSheetByName("Data CO"));
    aplicarEstiloCabeceraSimple(ss.getSheetByName("B2C RED VE"));

    // 🏆 GENERAR REPORTES EN RESUMEN
    generarTablasTop5(ss);
    generarTendenciaMensual(ss); 

    SpreadsheetApp.flush(); 

    // 📧 ENVÍO CORREO PRO
    enviarReporteCorreo(ss, repVE.summary, repGU.summary, repCO.summary, erroresGlobal.length);

    // 🌐 DASHBOARD POP-UP
    mostrarReporteResumenHTML(repVE.summary, repGU.summary, repCO.summary, erroresGlobal.length);
  
  } catch (e) {
    ui.alert("🚨 ERROR CRÍTICO:\n" + e.message);
  }
}

// ==========================================
// 🏆 TOP 5 (FILA 77)
// ==========================================
function generarTablasTop5(ss) {
  const sheet = ss.getSheetByName("Resumen");
  if (!sheet) return;
  const startRow = 77; 
  sheet.getRange(startRow, 1, 20, 15).clearContent().clearFormat();
  
  sheet.getRange("A" + startRow).setValue("🏆 CLIENTES TOP 5").setFontWeight("bold").setFontColor("#666");
  const rowHeaders = startRow + 2;
  const rowQuery = startRow + 3;

  // VE
  sheet.getRange(rowHeaders, 1).setValue("VENEZUELA").setBackground(ESTILO.COLOR_HEADER).setFontColor("white").setFontWeight("bold");
  sheet.getRange(rowQuery, 1).setFormula(`=QUERY('Data VE'!A:Z; "SELECT A, SUM(J) WHERE UPPER(L) = '"&UPPER(A1)&"' GROUP BY A ORDER BY SUM(J) DESC LIMIT 5 LABEL A 'CLIENTE', SUM(J) 'VENTA USD'"; 1)`);
  sheet.getRange(rowQuery, 1, 1, 2).setBackground(ESTILO.COLOR_SUBHEADER).setFontWeight("bold").setBorder(true, true, true, true, true, true, ESTILO.BORDE_COLOR, SpreadsheetApp.BorderStyle.SOLID);
  sheet.getRange(rowQuery + 1, 2, 5, 1).setNumberFormat("$#,##0.00");

  // CO
  sheet.getRange(rowHeaders, 4).setValue("COLOMBIA").setBackground(ESTILO.COLOR_HEADER).setFontColor("white").setFontWeight("bold");
  sheet.getRange(rowQuery, 4).setFormula(`=QUERY('Data CO'!A:Z; "SELECT A, SUM(J) WHERE UPPER(L) = '"&UPPER(A1)&"' GROUP BY A ORDER BY SUM(J) DESC LIMIT 5 LABEL A 'CLIENTE', SUM(J) 'VENTA USD'"; 1)`);
  sheet.getRange(rowQuery, 4, 1, 2).setBackground(ESTILO.COLOR_SUBHEADER).setFontWeight("bold").setBorder(true, true, true, true, true, true, ESTILO.BORDE_COLOR, SpreadsheetApp.BorderStyle.SOLID);
  sheet.getRange(rowQuery + 1, 5, 5, 1).setNumberFormat("$#,##0.00");

  // GU
  sheet.getRange(rowHeaders, 7).setValue("GUATEMALA").setBackground(ESTILO.COLOR_HEADER).setFontColor("white").setFontWeight("bold");
  sheet.getRange(rowQuery, 7).setFormula(`=QUERY('Data GU'!A:Z; "SELECT B, SUM(O) WHERE UPPER(Q) = '"&UPPER(A1)&"' GROUP BY B ORDER BY SUM(O) DESC LIMIT 5 LABEL B 'CLIENTE', SUM(O) 'VENTA USD'"; 1)`);
  sheet.getRange(rowQuery, 7, 1, 2).setBackground(ESTILO.COLOR_SUBHEADER).setFontWeight("bold").setBorder(true, true, true, true, true, true, ESTILO.BORDE_COLOR, SpreadsheetApp.BorderStyle.SOLID);
  sheet.getRange(rowQuery + 1, 8, 5, 1).setNumberFormat("$#,##0.00");
}

// ==========================================
// 📈 EVOLUCIÓN MENSUAL (FILA 88)
// ==========================================
function generarTendenciaMensual(ss) {
  const sheet = ss.getSheetByName("Resumen");
  if (!sheet) return;
  const startRow = 88;
  
  sheet.getRange(startRow, 1, 18, 7).clearContent().clearFormat();
  sheet.getRange("A" + startRow).setValue("📈 EVOLUCIÓN MENSUAL DE VENTAS (USD)").setFontWeight("bold").setFontColor("#666");

  const headers = ["MES", "VENEZUELA", "COLOMBIA", "GUATEMALA", "TOTAL", "TENDENCIA"];
  const headerRange = sheet.getRange(startRow + 2, 1, 1, 6);
  headerRange.setValues([headers]);
  headerRange.setBackground(ESTILO.COLOR_HEADER).setFontColor("white").setFontWeight("bold").setHorizontalAlignment("center");

  const meses = REGLAS.MESES;
  let filaActual = startRow + 3;
  const rangeTotal = `$E$${filaActual}:$E$${filaActual + 11}`;

  meses.forEach((mes) => {
    sheet.getRange(filaActual, 1).setValue(mes).setFontWeight("bold");
    sheet.getRange(filaActual, 2).setFormula(`=SUMIF('Data VE'!L:L; "${mes}"; 'Data VE'!J:J)`);
    sheet.getRange(filaActual, 3).setFormula(`=SUMIF('Data CO'!L:L; "${mes}"; 'Data CO'!J:J)`);
    sheet.getRange(filaActual, 4).setFormula(`=SUMIF('Data GU'!Q:Q; "${mes}"; 'Data GU'!O:O)`);
    sheet.getRange(filaActual, 5).setFormula(`=SUM(B${filaActual}:D${filaActual})`);
    const formulaSpark = `=SPARKLINE(B${filaActual}:D${filaActual}; {"charttype"\\"bar";"max"\\MAX(${rangeTotal});"color1"\\"${ESTILO.COLOR_HEADER}";"color2"\\"#7B1FA2";"color3"\\"#9575CD"})`;
    sheet.getRange(filaActual, 6).setFormula(formulaSpark);
    filaActual++;
  });

  const dataRange = sheet.getRange(startRow + 3, 2, 12, 4);
  dataRange.setNumberFormat("$#,##0.00");
  dataRange.setBorder(true, true, true, true, true, true, ESTILO.BORDE_COLOR, SpreadsheetApp.BorderStyle.SOLID);
  
  const totalRow = filaActual;
  sheet.getRange(totalRow, 1).setValue("TOTAL ANUAL").setBackground(ESTILO.COLOR_SUBHEADER).setFontWeight("bold");
  sheet.getRange(totalRow, 2).setFormula(`=SUM(B${startRow+3}:B${totalRow-1})`);
  sheet.getRange(totalRow, 3).setFormula(`=SUM(C${startRow+3}:C${totalRow-1})`);
  sheet.getRange(totalRow, 4).setFormula(`=SUM(D${startRow+3}:D${totalRow-1})`);
  sheet.getRange(totalRow, 5).setFormula(`=SUM(E${startRow+3}:E${totalRow-1})`);
  sheet.getRange(totalRow, 2, 1, 4).setFontWeight("bold").setNumberFormat("$#,##0.00").setBackground(ESTILO.COLOR_SUBHEADER);
}

