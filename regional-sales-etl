// 📧 EMAILING (DISEÑO SLIM & SPACED)
// ==========================================
function enviarReporteCorreo(ss, ve, gu, co, numErrores) {
  // 1. Resumen General
  const productos = ["OPEN NETW", "CLOSED NETW", "RENTAL", "LIVE", "AMPLIFY", "LEASING", "OTROS"];
  let holding = {}; let totalHolding = 0, totalVE = 0, totalGU = 0, totalCO = 0;
  productos.forEach(p => {
    let valVE = ve[p] || 0; let valGU = gu[p] || 0; let valCO = co[p] || 0;
    holding[p] = valVE + valGU + valCO; totalVE += valVE; totalGU += valGU; totalCO += valCO; totalHolding += holding[p];
  });
  
  const fmt = (num) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(num);
  let filasTabla = "";
  // ESTILO DE FILA: Padding reducido a 4px 8px para que sea "menos gorda"
  const tdStyle = "padding: 4px 8px; border-bottom:1px solid #eee;";
  
  productos.forEach((p, idx) => { 
    let bg = idx % 2 === 0 ? "#ffffff" : "#f9f9f9";
    filasTabla += `<tr style="background-color:${bg};">
      <td style="${tdStyle}">${p}</td>
      <td style="${tdStyle} text-align:right; font-weight:bold; color:#240046;">${fmt(holding[p] || 0)}</td>
      <td style="${tdStyle} text-align:right; color:#555;">${fmt(ve[p] || 0)}</td>
      <td style="${tdStyle} text-align:right; color:#555;">${fmt(co[p] || 0)}</td>
      <td style="${tdStyle} text-align:right; color:#555;">${fmt(gu[p] || 0)}</td>
    </tr>`; 
  });
  let filaTotal = `<tr style="background-color:#E0E0E0; font-weight:bold;">
    <td style="padding:8px;">TOTAL GLOBAL</td>
    <td style="padding:8px; text-align:right; color:#240046;">${fmt(totalHolding)}</td>
    <td style="padding:8px; text-align:right;">${fmt(totalVE)}</td>
    <td style="padding:8px; text-align:right;">${fmt(totalCO)}</td>
    <td style="padding:8px; text-align:right;">${fmt(totalGU)}</td>
  </tr>`;

  // 2. Extracción de Detalles
  const sheetResumen = ss.getSheetByName("Resumen");
  let htmlExtra = "";
  if(sheetResumen) {
    const datosRango = sheetResumen.getRange("A62:K105").getDisplayValues();
    // Padding reducido también aquí (4px)
    htmlExtra = `<h3 style="color:#240046; border-bottom:2px solid #240046; padding-bottom:5px; margin:0;">II. DETALLE OPERATIVO (TOP CLIENTES & TENDENCIAS)</h3>
                 <table style="width:100%; border-collapse:collapse; font-size:11px; font-family:Arial, sans-serif;">`;
    
    datosRango.forEach(fila => {
      if (fila.join("").trim() === "") return;
      htmlExtra += "<tr>";
      fila.forEach(celda => {
        let style = "padding:3px 5px; border:1px solid #f0f0f0;"; // Celdas delgadas
        if (celda.includes("VENEZUELA") || celda.includes("COLOMBIA") || celda.includes("GUATEMALA") || celda.includes("TOP 5") || celda.includes("EVOLUCIÓN") || celda === "TOTAL ANUAL" || celda === "MES") {
           style += "background-color:#240046; color:white; font-weight:bold; text-align:center;";
        } else if (celda.includes("CLIENTE") || celda.includes("VENTA USD") || celda.includes("DISTRIBUCIÓN") || celda.includes("TENDENCIA")) {
           style += "background-color:#E0E0E0; font-weight:bold; text-align:center;";
        }
        if (celda.includes("$") || !isNaN(celda.replace(/,/g, ""))) style += "text-align:right;";
        htmlExtra += `<td style="${style}">${celda}</td>`;
      });
      htmlExtra += "</tr>";
    });
    htmlExtra += "</table>";
  }

  // --- ENSAMBLAJE ---
  let colorStatus = numErrores > 0 ? "#D32F2F" : "#388E3C";
  let bgStatus = numErrores > 0 ? "#FFEBEE" : "#E8F5E9";
  let textoStatus = numErrores > 0 ? `⚠️ SE DETECTARON ${numErrores} ALERTAS` : "✅ DATA PROCESADA CORRECTAMENTE";
  const fechaHoy = new Date().toLocaleDateString();

  const htmlBody = `
    <div style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color:#333; max-width:900px; margin:0 auto; border:1px solid #ddd; background-color:#fff;">
      
      <div style="background-color:#240046; padding:25px; text-align:center;">
        <h1 style="color:#fff; margin:0; letter-spacing:2px; font-size:22px;">VENTAS WAWA 2026</h1>
        <p style="color:#ccc; margin:5px 0 0; font-size:11px;">REPORTE EJECUTIVO • ${fechaHoy}</p>
      </div>

      <div style="padding:25px;">
        
        <div style="background-color:${bgStatus}; color:${colorStatus}; padding:8px; text-align:center; font-weight:bold; border-radius:4px; font-size:12px; margin-bottom:20px;">
          ${textoStatus}
        </div>

        <h3 style="color:#240046; border-bottom:2px solid #240046; padding-bottom:5px; margin:0 0 10px 0;">I. VISIÓN GENERAL (USD)</h3>
        <table style="width:100%; border-collapse:collapse; font-size:12px; margin-bottom:0;">
          <thead>
            <tr style="background-color:#666; color:white;">
              <th style="padding:8px; text-align:left;">UNIDAD DE NEGOCIO</th>
              <th style="padding:8px; text-align:right;">HOLDING</th>
              <th style="padding:8px; text-align:right;">VENEZUELA</th>
              <th style="padding:8px; text-align:right;">COLOMBIA</th>
              <th style="padding:8px; text-align:right;">GUATEMALA</th>
            </tr>
          </thead>
          <tbody>${filasTabla}${filaTotal}</tbody>
        </table>

        <div style="height: 50px; border-bottom: 1px dashed #eee; margin-bottom: 30px;"></div>

        ${htmlExtra}
        
      </div>

      <div style="background-color:#f8f8f8; padding:15px; text-align:center; font-size:10px; color:#999; border-top:1px solid #eee;">
        <p style="margin:0;">Generado automáticamente por el Sistema Maestro Wawa V120.</p>
      </div>
    </div>`;

  let destinatario = CONFIG.EMAIL_DESTINO === "AUTO" ? Session.getActiveUser().getEmail() : CONFIG.EMAIL_DESTINO;
  MailApp.sendEmail({ to: destinatario, subject: CONFIG.ASUNTO_EMAIL, htmlBody: htmlBody });
}

